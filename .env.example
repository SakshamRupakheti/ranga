# No external API keys are required. Defaults work locally.
# Next.js proxy destination:
RANGA_BACKEND_URL=http://127.0.0.1:3003
# Set these in the service terminal environment when overriding defaults.
# The tsx service does not automatically load Next.js .env.local.
RANGA_ORIGIN=http://127.0.0.1:3001
RANGA_SERVICE_PORT=3003
RANGA_DATA_DIR=.ranga-data
# A private session secret is generated in RANGA_DATA_DIR on first start.
# Never commit that directory, a reset outbox, credentials or user assets.
